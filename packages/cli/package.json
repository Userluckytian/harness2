{
  "name": "harness2",
  "version": "1.0.0",
  "description": "跨端 AI agent harness —— 终端里接真实模型干活：流式 chat、工具执行、/undo /redo、轨迹可查",
  "license": "MIT",
  "type": "module",
  "bin": {
    "harness2": "./dist/index.js"
  },
  "files": [
    "dist",
    "dist-bundle"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist-bundle/harness2-cli.cjs --alias:jsonc-parser=jsonc-parser/lib/esm/main.js --external:playwright"
  },
  "dependencies": {
    "@harness2/core": "workspace:^",
    "@harness2/gateway": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
