{
  "name": "@harness2/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "harness2 Electron 桌面端：spawn 本地 serve（HTTP+WS），渲染进程零 Node",
  "type": "commonjs",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "pnpm build && electron .",
    "smoke": "pnpm build && electron . --smoke",
    "dist": "pnpm dist:win",
    "dist:win": "pnpm build && pnpm --filter harness2 bundle && electron-builder --win",
    "dist:mac": "pnpm build && pnpm --filter harness2 bundle && electron-builder --mac",
    "dist:linux": "pnpm build && pnpm --filter harness2 bundle && electron-builder --linux"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
