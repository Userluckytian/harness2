// 全量类型检查（noEmit）：src + test 统一入口。
// 与 base 的差异：源平面是**浏览器侧**（DOM + JSX），且本包以 Bundler 解析（产物由
// tsconfig.build.{esm,cjs}.json 双构建，见 dist-type.mjs 写的 dist/*/package.json 类型标记）。
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    // shadcn 约定：`@/` = 本包 src。注意各壳的 vite 也把 `@` 指向本包 src
    // （组件内部引用需要），因此**壳内代码不要用 `@/`，用相对路径**。
    // 注：本包用 TypeScript 7，baseUrl 已被移除，paths 相对 tsconfig 所在目录解析。
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "vitest.config.mts"]
}
