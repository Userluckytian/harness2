{
  "id": "B1-stream-midshot",
  "group": "B 对话",
  "watch": "流式中与完成后两帧：打字机增量、光标、tool 边界是否与 grok 一致",
  "canvas": { "cols": 110, "rows": 30 },
  "sides": {
    "ours": {
      "argv": [
        "node",
        "${REPO}/packages/cli/dist/index.js",
        "chat",
        "--provider",
        "mock",
        "--home",
        "${TMP_HOME}/home",
        "--root",
        "${TMP_HOME}/work"
      ]
    },
    "grok": { "argv": ["${GROK}", "--cwd", "${TMP_HOME}/work"] }
  },
  "steps": [
    { "keys": "hi\r", "wait": 0.6, "shot": "01-stream-mid" },
    { "shot": "02-reply-done", "timeout": 25 },
    { "keys": "/exit\r", "shot": "99-exit" }
  ]
}
