{
  "id": "J1-busy-queue",
  "group": "J 队列",
  "watch": "忙碌时回车排队：队列指示行/条数、排空后是否按序执行",
  "canvas": { "cols": 110, "rows": 30 },
  "sides": {
    "ours": {
      "argv": [
        "node",
        "${REPO}/packages/cli/dist/index.js",
        "chat",
        "--provider",
        "mock",
        "--home",
        "${TMP_HOME}/home",
        "--root",
        "${TMP_HOME}/work"
      ]
    },
    "grok": { "argv": ["${GROK}", "--cwd", "${TMP_HOME}/work"] }
  },
  "steps": [
    { "keys": "hi\r", "wait": 0.5 },
    { "keys": "第二条排队消息\r", "wait": 0.8, "shot": "01-queued" },
    { "shot": "02-drained", "timeout": 30 },
    { "keys": "/exit\r" }
  ]
}
